<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane prefWidth="860" prefHeight="660" stylesheets="@style.css" styleClass="luxury-root-dark"
           style="-fx-padding: 24;"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="control.grafico.LoginControlGrafico">

    <VBox spacing="11" alignment="CENTER" maxWidth="400" styleClass="luxury-black-gold-card"
          style="-fx-padding: 28 34;">
        <StackPane alignment="CENTER">
            <Circle radius="28" style="-fx-fill: #171617; -fx-stroke: #2e2b27; -fx-stroke-width: 1;"/>
            <Circle radius="24" style="-fx-fill: transparent; -fx-stroke: #baa487; -fx-stroke-width: 0.8; -fx-stroke-dash-array: 2 3;"/>
            <Label text="❄" style="-fx-font-size: 12px; -fx-text-fill: #baa487; -fx-padding: 0 0 14 0;"/>
            <Label text="F" style="-fx-font-family: 'Georgia'; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #ede6dc; -fx-padding: 5 0 0 0;"/>
        </StackPane>
        <VBox alignment="CENTER" spacing="2">
            <Label text="F R O S T L Y"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #ede6dc; -fx-letter-spacing: 4px;"/>
            <Label text="REGISTRAZIONE NUOVO CLIENTE"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 10.5px; -fx-font-weight: bold; -fx-text-fill: #8f8475; -fx-letter-spacing: 1.5px;"/>
        </VBox>

        <!-- SEPARATORE DISCRETO -->
        <HBox alignment="CENTER" spacing="10" maxWidth="330" style="-fx-padding: 2 0;">
            <Region HBox.hgrow="ALWAYS" style="-fx-background-color: #211f22; -fx-pref-height: 1; -fx-max-height: 1;"/>
            <Label text="CREA IL TUO PROFILO"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #736c64; -fx-letter-spacing: 1px;"/>
            <Region HBox.hgrow="ALWAYS" style="-fx-background-color: #211f22; -fx-pref-height: 1; -fx-max-height: 1;"/>
        </HBox>
        <VBox spacing="7" maxWidth="330">
            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Nome"
                           style="-fx-font-family: 'Georgia'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c7beb2;"/>
                    <TextField fx:id="campoNomeReg" promptText="Nome" styleClass="luxury-input"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Cognome"
                           style="-fx-font-family: 'Georgia'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c7beb2;"/>
                    <TextField fx:id="campoCognomeReg" promptText="Cognome" styleClass="luxury-input"/>
                </VBox>
            </HBox>

            <Label text="Indirizzo Email"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c7beb2;"/>
            <TextField fx:id="campoEmailReg" promptText="nome@email.it" styleClass="luxury-input"/>

            <Label text="Password"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c7beb2;"/>
            <PasswordField fx:id="campoPasswordReg" promptText="Minimo 4 caratteri" styleClass="luxury-input"/>
        </VBox>
        <VBox spacing="7" maxWidth="330" style="-fx-padding: 3 0 0 0;">
            <Button text="CONFERMA REGISTRAZIONE" onAction="#onClickConfermaRegistrazione"
                    prefWidth="330" styleClass="luxury-gold-btn"/>
            <Button text="⬅ Torna all'Accesso" onAction="#onClickTornaALogin"
                    prefWidth="330" styleClass="luxury-sub-btn"/>
        </VBox>
        <Label fx:id="etichettaMessaggio" wrapText="true" alignment="CENTER"
               style="-fx-text-fill: #f87171; -fx-font-weight: bold; -fx-font-size: 12.5px;"/>
    </VBox>
</StackPane>
