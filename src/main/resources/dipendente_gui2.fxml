<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1180" prefHeight="760" stylesheets="@style.css" styleClass="root-dark"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="control.grafico.TurniControlGrafico">

    <top>
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="top-bar-dark">
            <VBox>
                <Label text="FROSTLY — AREA PERSONALE STAFF"
                       style="-fx-text-fill: #f5ebe0; -fx-font-family: 'Georgia'; -fx-font-size: 16.5px; -fx-font-weight: bold;"/>
                <Label fx:id="lblIntestazione" style="-fx-text-fill: #baa487; -fx-font-size: 11.5px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Esci (Logout)" onAction="#onClickLogout" styleClass="btn-outline"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-padding: 8 12;">

            <Tab text="📅 Turni Staff &amp; Calendario">
                <VBox spacing="10" styleClass="dark-card" style="-fx-padding: 14 18;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Calendario Turni di Lavoro Settimanali Staff"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #f5ebe0;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblRiepilogoTurniDipendente"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #baa487;"/>
                    </HBox>

                    <!-- BARRA NAVIGAZIONE SETTIMANE CALENDARIO -->
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="luxury-toolbar">
                        <Button text="◀ Settimana Prec." onAction="#onClickSettimanaPrecedente" styleClass="btn-warm" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                        <Button text="Oggi" onAction="#onClickSettimanaCorrente" styleClass="btn-outline" style="-fx-font-size: 11px; -fx-padding: 4 8;"/>
                        <Button text="Settimana Succ. ▶" onAction="#onClickSettimanaSuccessiva" styleClass="btn-warm" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblSettimanaAttiva" text="📅 Settimana:"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #f5ebe0;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Vai al giorno:" style="-fx-font-size: 11.5px; -fx-text-fill: #baa487; -fx-font-weight: bold;"/>
                        <DatePicker fx:id="datePickerSettimana" onAction="#onCambioDataPicker" prefWidth="135"/>
                    </HBox>

                    <Label text="💡 Clicca su un tuo turno (evidenziato con ⭐) nella tabella per aprire il pop-up e segnalare un'emergenza o richiesta di modifica al Maestro."
                           style="-fx-font-size: 11.5px; -fx-text-fill: #baa487; -fx-font-style: italic;"/>

                    <!-- GRIGLIA CALENDARIO TABELLARE SETTIMANALE -->
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS" prefHeight="380">
                        <VBox fx:id="boxCalendarioTurni" spacing="6" style="-fx-padding: 2;"/>
                    </ScrollPane>

                    <!-- CAMPI RETROCOMPATIBILI -->
                    <ListView fx:id="listaTurniDipendente" visible="false" managed="false"/>
                    <Label fx:id="lblTurnoSelezionatoEmergenza" visible="false" managed="false"/>
                    <TextField fx:id="campoCodiceTurno" visible="false" managed="false"/>
                    <ComboBox fx:id="comboMotivazioneRapida" visible="false" managed="false"/>
                    <TextField fx:id="campoMotivazione" visible="false" managed="false"/>

                    <Separator/>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📢 Comunicazioni di Servizio Ricevute"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #f5ebe0;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="🗑️ Elimina Selezionato" onAction="#onClickEliminaAvvisoSelezionato" styleClass="btn-outline"
                                style="-fx-text-fill: #ef4444; -fx-border-color: rgba(239,68,68,0.5); -fx-font-size: 11px;"/>
                    </HBox>
                    <ListView fx:id="listaNotifiche" prefHeight="85"/>
                </VBox>
            </Tab>

            <Tab text="🍨 Gestione Menu Vetrina">
                <VBox spacing="6" styleClass="dark-card" style="-fx-padding: 10 14;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <HBox fx:id="boxCategorieMenu" spacing="6" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"/>
                        <Button text="➕ Nuovo Prodotto" onAction="#onClickNuovoGustoMenu" styleClass="btn-sage" minWidth="-Infinity"/>
                    </HBox>
                    <HBox fx:id="boxSottocategorieMenu" spacing="6" alignment="CENTER_LEFT" minHeight="24"/>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="540" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <FlowPane fx:id="grigliaMenuGestione" hgap="14" vgap="14" style="-fx-padding: 4;"/>
                    </ScrollPane>

                    <HBox spacing="6" alignment="CENTER_LEFT" visible="false" managed="false">
                        <Label fx:id="lblCategoriaFormMenu" text="📂 Reparto: 🍨 Gelati" minWidth="-Infinity"
                               style="-fx-font-weight: bold; -fx-padding: 5 10; -fx-background-color: rgba(35,32,38,0.85); -fx-background-radius: 10; -fx-text-fill: #baa487; -fx-font-size: 11px;"/>
                        <ComboBox fx:id="comboCategoriaMenu" visible="false" managed="false"/>
                        <ComboBox fx:id="comboSottocategoriaMenu" visible="false" managed="false"/>
                        <TextField fx:id="campoNomeGustoMenu" promptText="Nome Prodotto" prefWidth="165"/>
                        <TextField fx:id="campoPrezzoGustoMenu" promptText="Prezzo €" prefWidth="85"/>
                        <TextField fx:id="campoAllergeniGustoMenu" promptText="Allergeni" prefWidth="140"/>
                        <TextField fx:id="campoDescGustoMenu" promptText="Descrizione artigianale" HBox.hgrow="ALWAYS"/>
                        <Button text="📁 Scegli foto…" minWidth="-Infinity" onAction="#onClickScegliFoto" styleClass="btn-warm"/>
                        <Label fx:id="lblStatoFotoMenu" text="Nessuna foto" minWidth="-Infinity" style="-fx-font-size: 11px; -fx-text-fill: #baa487; -fx-font-style: italic;"/>
                        <Button fx:id="btnRimuoviFoto" text="✕" minWidth="-Infinity" onAction="#onClickRimuoviFoto" styleClass="btn-outline" style="-fx-padding: 2 7; -fx-font-size: 10.5px;" visible="false" managed="false"/>
                        <TextField fx:id="campoImmagineMenu" visible="false" managed="false"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
                        <Button text="🆕 Nuovo Gusto (svuota)" onAction="#onClickNuovoGustoMenu" styleClass="btn-warm"/>
                        <Button text="➕ Salva / Aggiorna" onAction="#onClickSalvaGustoMenu" styleClass="btn-sage"/>
                        <Button text="🔄 Disponibile / Esaurito" onAction="#onClickCambiaDisponibilitaGusto" styleClass="btn-warm"/>
                        <Button text="🗑️ Rimuovi" onAction="#onClickRimuoviGustoMenu" styleClass="btn-danger"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- ================= TAB: MAGAZZINO STAFF ================= -->
            <Tab text="📦 Magazzino">
                <VBox spacing="12" styleClass="dark-card" style="-fx-padding: 14 18;">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Giacenze Prodotti Menu &amp; Materie Prime"
                               style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblRiepilogoMagazzino" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                    </HBox>

                    <!-- BARRA FILTRI CATEGORIA & RICERCA (NO SCROLLBAR) -->
                    <HBox spacing="14" alignment="CENTER_LEFT" styleClass="luxury-toolbar">
                        <Label text="📂 Categoria:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                        <ComboBox fx:id="comboCategoriaMagazzino" prefWidth="230"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="campoRicercaMagazzino" promptText="🔍 Cerca prodotto o ingrediente..." prefWidth="280"/>
                    </HBox>

                    <ListView fx:id="listaMagazzino" VBox.vgrow="ALWAYS"/>
                    <Label text="Barra oro/verde = scorta ottimale. Barra rossa = livello sotto soglia minima (da riordinare subito)."
                           style="-fx-font-size: 11.5px; -fx-text-fill: #baa487;"/>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="luxury-toolbar">
                        <Label text="Gestione Giacenze:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                        <TextField fx:id="campoNomeIngredienteRifornimento" promptText="Seleziona dalla lista sopra" prefWidth="240" editable="false" style="-fx-background-color: rgba(30,28,32,0.85); -fx-font-weight: bold; -fx-text-fill: #f5ebe0; -fx-border-color: rgba(186,164,135,0.3);"/>
                        <TextField fx:id="campoKgRifornimento" promptText="Quantità (es. 10)" prefWidth="130"/>
                        <Button text="📦 Carico (+)" onAction="#onClickRegistraRifornimentoManuale" styleClass="btn-primary" style="-fx-font-weight: bold; -fx-padding: 7 14;"/>
                        <Button text="📤 Scarico (-)" onAction="#onClickRegistraScaricoManuale" styleClass="btn-outline" style="-fx-font-weight: bold; -fx-padding: 7 12;"/>
                        <Button text="🗑 Elimina Voce" onAction="#onClickEliminaIngredienteMagazzino" styleClass="btn-outline" style="-fx-font-weight: bold; -fx-padding: 7 12; -fx-text-fill: #ef4444; -fx-border-color: #ef4444;"/>
                    </HBox>

                    <Separator/>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="luxury-toolbar">
                        <Label text="➕ Nuova Voce:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                        <TextField fx:id="campoNuovoNomeIngrediente" promptText="Nome Prodotto / Materia Prima" prefWidth="220"/>
                        <TextField fx:id="campoNuovaQtaIngrediente" promptText="Q.tà Iniziale (es. 20)" prefWidth="130"/>
                        <TextField fx:id="campoNuovaSogliaIngrediente" promptText="Soglia Min. (es. 5)" prefWidth="120"/>
                        <ComboBox fx:id="comboNuovaUnitaIngrediente" promptText="Unità Misura" prefWidth="130"/>
                        <Button text="✨ Aggiungi al Magazzino" onAction="#onClickAggiungiNuovoIngrediente" styleClass="btn-primary" style="-fx-font-weight: bold; -fx-padding: 7 14;"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="🛵 Ordini Ricevuti">
                <VBox spacing="12" styleClass="dark-card" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="🛵 Ordini Deliveroo &amp; Take Away da Gestire"
                               style="-fx-font-family: 'Georgia'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #f5ebe0;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblConteggioOrdiniStaff" text="(0 ordini)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #baa487;"/>
                        <Button text="🔄 Aggiorna Ordini" onAction="#onClickAggiornaOrdiniStaff" styleClass="btn-outline"/>
                    </HBox>
                    <Label text="💡 Clicca '✔ Conferma' per avviare la preparazione o '✕ Disdici' se i gusti sono esauriti."
                           style="-fx-font-size: 11.5px; -fx-text-fill: #baa487; -fx-font-style: italic;"/>
                    <ListView fx:id="listaOrdiniStaff" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Button text="✕ Disdici Ordine Selezionato" onAction="#onClickDisdiciOrdineStaff" styleClass="btn-danger" style="-fx-font-weight: bold; -fx-padding: 7 14;"/>
                        <Button text="✔ Conferma Ordine Selezionato" onAction="#onClickConfermaOrdineStaff" styleClass="btn-primary" style="-fx-font-weight: bold; -fx-padding: 7 14;"/>
                    </HBox>
                </VBox>
            </Tab>

        </TabPane>
    </center>

    <bottom>
        <HBox style="-fx-padding: 8 24; -fx-background-color: rgba(14, 13, 16, 0.95); -fx-border-color: rgba(186,164,135,0.22) transparent transparent transparent; -fx-border-width: 1;">
            <Label fx:id="lblEsito" text="Seleziona un turno o un gusto della vetrina con un click."
                   style="-fx-text-fill: #baa487; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>
</BorderPane>
