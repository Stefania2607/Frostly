<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane prefWidth="860" prefHeight="660" stylesheets="@style.css" styleClass="luxury-root-dark"
           style="-fx-padding: 24;"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="control.grafico.LoginControlGrafico">

    <VBox spacing="11" alignment="CENTER" maxWidth="450" styleClass="luxury-black-gold-card"
          style="-fx-padding: 26 36;">
        <StackPane alignment="CENTER">
            <Circle radius="32" style="-fx-fill: #171617; -fx-stroke: #2e2b27; -fx-stroke-width: 1;"/>
            <Circle radius="28" style="-fx-fill: transparent; -fx-stroke: #baa487; -fx-stroke-width: 0.8; -fx-stroke-dash-array: 2 3;"/>
            <Label text="❄" style="-fx-font-size: 12px; -fx-text-fill: #baa487; -fx-padding: 0 0 16 0;"/>
            <Label text="F" style="-fx-font-family: 'Georgia'; -fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #ede6dc; -fx-padding: 6 0 0 0;"/>
        </StackPane>
        <VBox alignment="CENTER" spacing="4">
            <Label text="F R O S T L Y"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #f5ebe0; -fx-letter-spacing: 4px;"/>
            <Label text="HAUTE GELATERIA ARTIGIANALE • DAL 1984"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #b5a898; -fx-letter-spacing: 1.5px;"/>
        </VBox>
        <VBox spacing="7" maxWidth="380">
            <Button text="🍨  Consulta la Carta del Giorno (Accesso Libero)" onAction="#onClickApriMenuPubblico"
                    prefWidth="380" styleClass="luxury-outline-btn"/>
            <Button text="⭐  Recensioni d'Eccellenza dei Clienti" onAction="#onClickApriRecensioniPubbliche"
                    prefWidth="380" styleClass="luxury-outline-btn"/>
        </VBox>

        <!-- SEPARATORE DISCRETO -->
        <HBox alignment="CENTER" spacing="10" maxWidth="380" style="-fx-padding: 3 0;">
            <Region HBox.hgrow="ALWAYS" style="-fx-background-color: #2b282e; -fx-pref-height: 1; -fx-max-height: 1;"/>
            <Label text="ACCESSO RISERVATO"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 10.5px; -fx-font-weight: bold; -fx-text-fill: #9e9384; -fx-letter-spacing: 1px;"/>
            <Region HBox.hgrow="ALWAYS" style="-fx-background-color: #2b282e; -fx-pref-height: 1; -fx-max-height: 1;"/>
        </HBox>
        <VBox spacing="7" maxWidth="380">
            <Label text="Indirizzo Email"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #ded7cd;"/>
            <TextField fx:id="campoEmail" promptText="nome@esempio.it" styleClass="luxury-input"/>

            <Label text="Password"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #ded7cd;"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="campoPassword" promptText="Inserisci la password" styleClass="luxury-input"/>
                    <TextField fx:id="campoPasswordVisibile" promptText="Inserisci la password" styleClass="luxury-input"
                               visible="false" managed="false"/>
                </StackPane>
                <Button fx:id="btnMostraPassword" text="👁" onAction="#onClickMostraNascondiPassword"
                        minWidth="40" prefWidth="40"
                        style="-fx-background-color: #1c1a20; -fx-text-fill: #baa487; -fx-border-color: rgba(186,164,135,0.35); -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px; -fx-padding: 7 0; -fx-cursor: hand;"/>
            </HBox>

            <HBox spacing="16" alignment="CENTER" style="-fx-padding: 4 0 2 0;">
                <HBox spacing="8" alignment="CENTER">
                    <Label text="Versione:" style="-fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #b5a898;"/>
                    <ComboBox fx:id="comboModalita" prefWidth="120" styleClass="luxury-combo"/>
                </HBox>
                <CheckBox fx:id="checkSecondaGui" text="GUI 2 (Provenza Lavanda)"
                          style="-fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #b5a898;"/>
            </HBox>
        </VBox>
        <Button text="ACCEDI AL SISTEMA" onAction="#onClickLogin" prefWidth="380" styleClass="luxury-gold-btn"/>
        <VBox alignment="CENTER" spacing="5" maxWidth="380" style="-fx-padding: 2 0 0 0;">
            <Label text="Non fai ancora parte del nostro Club di Gelateria?"
                   style="-fx-font-size: 12px; -fx-text-fill: #9e9384; -fx-font-style: italic;"/>
            <Button text="Crea un Nuovo Profilo Cliente" onAction="#onClickVaiARegistrazione"
                    prefWidth="380" styleClass="luxury-sub-btn"/>
        </VBox>
        <Label fx:id="etichettaMessaggio" wrapText="true" alignment="CENTER"
               style="-fx-text-fill: #e57373; -fx-font-weight: bold; -fx-font-size: 13px;"/>
    </VBox>
</StackPane>
