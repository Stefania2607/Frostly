<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1220" prefHeight="780" stylesheets="@style_gui2.css" styleClass="root-dark"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="control.grafico.GelateriaControlGrafico">

    <top>
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="top-bar-dark">
            <Label text="FROSTLY"
                   style="-fx-font-family: 'Georgia'; -fx-text-fill: #f5ebe0; -fx-font-weight: bold; -fx-font-size: 18px;"/>
            <Label text="•  Haute Gelateria &amp; Tea Salon"
                   style="-fx-text-fill: #baa487; -fx-font-size: 13px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblIntestazione" text="Ospite"
                   style="-fx-text-fill: #f5ebe0; -fx-font-weight: bold; -fx-font-size: 13.5px;"/>
            <Button fx:id="btnApriCarrello" text="🛒 Vedi Carrello (0 prodotti • EUR 0.00)"
                    onAction="#onClickApriCarrello" styleClass="btn-primary"/>
            <Button text="Esci (Logout)" onAction="#onClickLogout" styleClass="btn-outline"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="4" style="-fx-padding: 8 12;">
            <TabPane side="LEFT" rotateGraphic="false" tabMinWidth="46" tabMaxWidth="46" tabMinHeight="215" tabMaxHeight="215"
                     tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <Tab>
                    <graphic><Label text="🍨 Menu &amp; Ordinazione" styleClass="sidebar-tab-label"/></graphic>
                    <VBox spacing="6" styleClass="dark-card" style="-fx-padding: 10 14;">
                        <ScrollPane vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" minHeight="52" prefHeight="52"
                                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                            <HBox fx:id="boxCategorieCliente" spacing="6" alignment="CENTER_LEFT" visible="false" managed="false" style="-fx-padding: 2 2 10 2;"/>
                        </ScrollPane>

                        <!-- CONTENUTO PRINCIPALE: PRODOTTI A SINISTRA + COMPOSITORE VASCHETTA A DESTRA -->
                        <HBox spacing="12" VBox.vgrow="ALWAYS">
                            <!-- GRIGLIA PRODOTTI SELEZIONABILI (SINISTRA) -->
                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" HBox.hgrow="ALWAYS"
                                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                                <VBox fx:id="boxGustiDisponibili" spacing="8" style="-fx-padding: 4;"/>
                            </ScrollPane>

                            <!-- COLONNA DESTRA: COMPOSIZIONE VASCHETTA (VISIBILE QUANDO SI SELEZIONA GELATI) -->
                            <VBox fx:id="boxSezioneVaschetta" spacing="9" prefWidth="320" minWidth="320" maxWidth="320"
                                  visible="false" managed="false"
                                  style="-fx-background-color: rgba(26,24,28,0.94); -fx-border-color: rgba(186,164,135,0.35); -fx-border-width: 1.2; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 12 14;">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="🍨 Componi la Vaschetta" minWidth="-Infinity"
                                           style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="🔄 Svuota" minWidth="-Infinity" onAction="#onClickSvuotaVaschetta"
                                            styleClass="btn-outline" style="-fx-font-size: 12px; -fx-padding: 3 8;"/>
                                </HBox>

                                <Label text="1. Scegli il formato desiderato:"
                                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                                <VBox spacing="6">
                                    <HBox spacing="6">
                                        <Button fx:id="btnFormato350" text="350g" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onClickFormato350" styleClass="btn-outline" style="-fx-font-size: 12.5px;"/>
                                        <Button fx:id="btnFormato500" text="500g" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onClickFormato500" styleClass="btn-outline" style="-fx-font-size: 12.5px;"/>
                                    </HBox>
                                    <HBox spacing="6">
                                        <Button fx:id="btnFormato750" text="750g" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onClickFormato750" styleClass="btn-outline" style="-fx-font-size: 12.5px;"/>
                                        <Button fx:id="btnFormato1000" text="1 Kg" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onClickFormato1000" styleClass="btn-outline" style="-fx-font-size: 12.5px;"/>
                                    </HBox>
                                </VBox>

                                <HBox alignment="CENTER_LEFT">
                                    <Label text="2. Scomparti vaschetta:"
                                           style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblCapienzaVaschetta" text="0/4 gusti scelti (500g)" minWidth="-Infinity"
                                           style="-fx-font-weight: bold; -fx-font-size: 12.5px; -fx-text-fill: #baa487;"/>
                                </HBox>

                                <HBox fx:id="boxVaschettaGrafica" alignment="CENTER" spacing="6" VBox.vgrow="ALWAYS"
                                      style="-fx-background-color: rgba(18,16,20,0.85); -fx-border-color: rgba(186,164,135,0.30); -fx-border-width: 1.5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 8;"/>

                                <VBox spacing="5" style="-fx-background-color: rgba(32,29,35,0.90); -fx-border-color: rgba(186,164,135,0.22); -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 8 10;">
                                    <Label text="3. Guarnizioni extra sulla vaschetta:"
                                           style="-fx-font-weight: bold; -fx-font-size: 12.5px; -fx-text-fill: #baa487;"/>
                                    <CheckBox fx:id="checkPanna" text="☁️ +Panna Montata Fresca" minWidth="-Infinity" style="-fx-font-size: 12.5px; -fx-text-fill: #f5ebe0;"/>
                                    <CheckBox fx:id="checkGranella" text="✨ +Granella di Pistacchio" minWidth="-Infinity" style="-fx-font-size: 12.5px; -fx-text-fill: #f5ebe0;"/>
                                </VBox>

                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="Prezzo Vaschetta:" style="-fx-font-weight: bold; -fx-font-size: 13.5px; -fx-text-fill: #baa487;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblPrezzoVaschettaCorrente" text="EUR 0.00" minWidth="-Infinity"
                                           style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #baa487;"/>
                                </HBox>

                                <Button text="➕ Metti Vaschetta nel Carrello" maxWidth="Infinity" minWidth="-Infinity"
                                        onAction="#onClickAggiungiVaschettaAlCarrello"
                                        styleClass="btn-primary" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 9 14;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </Tab>
                <Tab>
                    <graphic><Label text="⭐ Recensioni" styleClass="sidebar-tab-label"/></graphic>
                    <HBox spacing="18" alignment="TOP_LEFT" style="-fx-padding: 14 8;">
                        <VBox spacing="11" prefWidth="335" minWidth="320" maxHeight="-Infinity" styleClass="dark-card" style="-fx-padding: 20 22;">
                            <Label text="Lascia la tua Recensione" wrapText="true"
                                   style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 17px; -fx-text-fill: #f5ebe0;"/>
                            <Label text="Condividi la tua esperienza con il Maestro e con la community!"
                                   wrapText="true" style="-fx-font-size: 12.5px; -fx-text-fill: #d6b48a;"/>

                            <Label text="Valutazione (Stelle)" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #f5ebe0;"/>
                            <ComboBox fx:id="comboVotoRecensione" maxWidth="Infinity"/>

                            <Label text="Titolo della Recensione" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #f5ebe0;"/>
                            <TextField fx:id="campoTitoloRecensione" promptText="Es. Il miglior pistacchio di Roma!"/>

                            <Label text="Il tuo Commento Artigianale" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #f5ebe0;"/>
                            <TextArea fx:id="campoCommentoRecensione" promptText="Racconta cosa ti è piaciuto del gelato, delle crepes o del servizio..."
                                      wrapText="true" prefRowCount="5"/>

                            <Button text="⭐ Pubblica la tua Recensione" onAction="#onClickPubblicaRecensione"
                                    maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 10 16; -fx-font-weight: bold;"/>
                        </VBox>

                        <VBox spacing="12" HBox.hgrow="ALWAYS" maxHeight="510" styleClass="dark-card" style="-fx-padding: 20 22;">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <VBox spacing="2">
                                    <Label text="Cosa Dicono i Nostri Clienti"
                                           style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 17px; -fx-text-fill: #f5ebe0;"/>
                                    <Label fx:id="lblMediaRecensioniCliente" text="⭐ Valutazione in caricamento..."
                                           style="-fx-font-weight: bold; -fx-font-size: 13.5px; -fx-text-fill: #d6b48a;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="🔄 Aggiorna" onAction="#onClickAggiornaRecensioni" styleClass="btn-outline" style="-fx-font-size: 12.5px; -fx-padding: 5 12;"/>
                            </HBox>

                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                <VBox fx:id="boxCardsRecensioniCliente" spacing="12" style="-fx-padding: 4 4;"/>
                            </ScrollPane>

                            <ListView fx:id="listaNotificheCliente" visible="false" managed="false"/>
                        </VBox>
                    </HBox>
                </Tab>
                <Tab>
                    <graphic><Label text="📦 I Miei Ordini" styleClass="sidebar-tab-label"/></graphic>
                    <VBox spacing="10" styleClass="dark-card" style="-fx-padding: 16;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="2">
                                <Label text="I Miei Pre-Ordini in Boutique"
                                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #f5ebe0;"/>
                                <Label text="Consulta i tuoi ordini inviati alla gelateria, il dettaglio dei prodotti e lo stato di conferma."
                                       style="-fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="🔄 Aggiorna Ordini" onAction="#onClickAggiornaOrdini" styleClass="btn-outline"/>
                        </HBox>
                        <ListView fx:id="listaMieiOrdini" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
