                            <Button text="Turni ➔" onAction="#onClickApriSezioneTurni" styleClass="btn-outline" style="-fx-font-size: 11.5px; -fx-padding: 3 8;"/>
                        </HBox>
                        <ListView fx:id="listaEmergenze" prefHeight="135"/>
                        <TextField fx:id="campoCodEmergenza" visible="false" managed="false"/>
                        <ComboBox fx:id="comboSostituto" visible="false" managed="false"/>
                        <TextField fx:id="campoEmailSostituto" visible="false" managed="false"/>
                        <TextField fx:id="campoNotaMaestro" visible="false" managed="false"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </right>

    <bottom>
