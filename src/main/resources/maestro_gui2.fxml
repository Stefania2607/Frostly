                            <Label text="🛵 Ordini in Attesa"
                                   style="-fx-font-weight: bold; -fx-font-size: 13.5px; -fx-text-fill: #f5ebe0;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Gestisci ➔" onAction="#onClickApriSezioneOrdini" styleClass="btn-outline" style="-fx-font-size: 11.5px; -fx-padding: 3 8;"/>
                        </HBox>
                        <ListView fx:id="listaOrdiniUrgentiTendina" prefHeight="110"/>
                    </VBox>

                    <!-- CARD 2: MANCANZE MAGAZZINO -->
                    <VBox spacing="8" style="-fx-background-color: rgba(24,22,27,0.92); -fx-border-color: rgba(239,68,68,0.32); -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10 12;">
