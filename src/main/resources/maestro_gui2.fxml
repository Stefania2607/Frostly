                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Magazzino ➔" onAction="#onClickApriSezioneMagazzino" styleClass="btn-outline" style="-fx-font-size: 11.5px; -fx-padding: 3 8;"/>
                        </HBox>
                        <ListView fx:id="listaUrgenzeMagazzino" prefHeight="210"/>
                        <TextField fx:id="campoIngredienteUrgente" visible="false" managed="false"/>
                    </VBox>

                    <!-- CARD 3: CAMBI TURNO STAFF -->
                    <VBox spacing="8" style="-fx-background-color: rgba(24,22,27,0.92); -fx-border-color: rgba(186,164,135,0.25); -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10 12;">
