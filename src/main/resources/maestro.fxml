                    <VBox spacing="8" style="-fx-background-color: rgba(34, 34, 40, 0.90); -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 16; -fx-background-radius: 16; -fx-padding: 14 14 10 14;">
