<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1220" prefHeight="780" stylesheets="@style.css" styleClass="root-dark"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="control.grafico.TurniControlGrafico">

    <top>
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="top-bar-dark">
            <VBox>
                <Label text="FROSTLY — DIREZIONE &amp; LABORATORIO"
                       style="-fx-text-fill: #f5ebe0; -fx-font-family: 'Georgia'; -fx-font-size: 16.5px; -fx-font-weight: bold;"/>
                <Label fx:id="lblIntestazione" style="-fx-text-fill: #baa487; -fx-font-size: 13px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnTendinaUrgenze" text="🔔 Notizie &amp; Urgenze" onAction="#onToggleTendinaUrgenze"
                    styleClass="btn-warm" style="-fx-cursor: hand; -fx-font-weight: bold;"/>
            <Button text="Esci (Logout)" onAction="#onClickLogout" styleClass="btn-outline"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabPaneMaestro" tabClosingPolicy="UNAVAILABLE" style="-fx-padding: 6 12;">
            <Tab text="🏠 Home">
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 6;">
                    <VBox spacing="18" styleClass="glass-card" style="-fx-padding: 24 28;">
                        <VBox spacing="4">
                            <Label text="QUADRO OPERATIVO DEL MAESTRO"
                                   style="-fx-font-family: 'Georgia'; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f5ebe0;"/>
                            <Label text="Seleziona un'area di gestione o consulta le notifiche urgenti nella tendina laterale a destra."
                                   style="-fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                        </VBox>

                        <Separator/>

                        <!-- Griglia Icone Eleganti per tutte le attività -->
                        <GridPane hgap="18" vgap="18" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33.3"/>
                                <ColumnConstraints percentWidth="33.3"/>
                                <ColumnConstraints percentWidth="33.3"/>
                            </columnConstraints>

                            <!-- CARD 1: Menu Vetrina -->
                            <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                  styleClass="luxury-tile"
                                  onMouseClicked="#onClickApriSezioneMenu">
                                <Label text="🍨" style="-fx-font-size: 42px;"/>
                                <Label text="Menu Vetrina &amp; Prodotti"
                                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                                <Label text="Gusti artigianali, caffetteria, dolci, foto dal PC e disponibilità al banco."
                                       wrapText="true" textAlignment="CENTER" style="-fx-font-size: 13px; -fx-text-fill: #baa487; -fx-min-height: 36px;"/>
                                <Button text="Gestisci Menu ➔" onAction="#onClickApriSezioneMenu" styleClass="btn-primary" style="-fx-font-size: 13px; -fx-padding: 6 16;"/>
                            </VBox>

                            <!-- CARD 2: Turni Settimanali -->
                            <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                  styleClass="luxury-tile"
                                  onMouseClicked="#onClickApriSezioneTurni">
                                <Label text="📅" style="-fx-font-size: 42px;"/>
                                <Label text="Pianificazione Turni Staff"
                                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                                <Label text="Orari di lavoro settimanali dei dipendenti e pubblicazione nuovi turni."
                                       wrapText="true" textAlignment="CENTER" style="-fx-font-size: 13px; -fx-text-fill: #baa487; -fx-min-height: 36px;"/>
                                <Button text="Pianifica Turni ➔" onAction="#onClickApriSezioneTurni" styleClass="btn-primary" style="-fx-font-size: 13px; -fx-padding: 6 16;"/>
                            </VBox>

                            <!-- CARD 3: Magazzino & Dispensa -->
                            <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="0"
                                  styleClass="luxury-tile"
                                  onMouseClicked="#onClickApriSezioneMagazzino">
                                <Label text="📦" style="-fx-font-size: 42px;"/>
                                <Label text="Dispensa &amp; Materie Prime"
                                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                                <Label text="Controllo giacenze D.O.P./I.G.P. e livello scorte con soglie di sicurezza."
                                       wrapText="true" textAlignment="CENTER" style="-fx-font-size: 13px; -fx-text-fill: #baa487; -fx-min-height: 36px;"/>
                                <Button text="Apri Dispensa ➔" onAction="#onClickApriSezioneMagazzino" styleClass="btn-primary" style="-fx-font-size: 13px; -fx-padding: 6 16;"/>
                            </VBox>

                            <!-- CARD 4: Recensioni Clienti -->
                            <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                  styleClass="luxury-tile"
                                  onMouseClicked="#onClickApriSezioneGusti">
                                <Label text="⭐" style="-fx-font-size: 42px;"/>
                                <Label text="Recensioni &amp; Feedback"
                                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                                <Label text="Opinioni dei clienti, valutazioni in stelle e risposte ufficiali del Maestro."
                                       wrapText="true" textAlignment="CENTER" style="-fx-font-size: 13px; -fx-text-fill: #baa487; -fx-min-height: 36px;"/>
                                <Button text="Leggi e Rispondi ➔" onAction="#onClickApriSezioneGusti" styleClass="btn-primary" style="-fx-font-size: 13px; -fx-padding: 6 16;"/>
                            </VBox>

                            <!-- CARD 5: Staff Dipendenti -->
                            <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                  styleClass="luxury-tile"
                                  onMouseClicked="#onClickApriSezioneStaff">
                                <Label text="👥" style="-fx-font-size: 42px;"/>
                                <Label text="Gestione Personale &amp; Staff"
                                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                                <Label text="Crea profili protetti per i nuovi dipendenti e consulta la squadra."
                                       wrapText="true" textAlignment="CENTER" style="-fx-font-size: 13px; -fx-text-fill: #baa487; -fx-min-height: 36px;"/>
                                <Button text="Gestisci Staff ➔" onAction="#onClickApriSezioneStaff" styleClass="btn-primary" style="-fx-font-size: 13px; -fx-padding: 6 16;"/>
                            </VBox>

                            <!-- CARD 6: Registro Attività -->
                            <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1"
                                  styleClass="luxury-tile"
                                  onMouseClicked="#onClickApriSezioneAvvisi">
                                <Label text="📋" style="-fx-font-size: 42px;"/>
                                <Label text="Registro Attività &amp; Notifiche"
                                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                                <Label text="Storico cronologico di tutte le comunicazioni e variazioni operative."
                                       wrapText="true" textAlignment="CENTER" style="-fx-font-size: 13px; -fx-text-fill: #baa487; -fx-min-height: 36px;"/>
                                <Button text="Consulta Storico ➔" onAction="#onClickApriSezioneAvvisi" styleClass="btn-primary" style="-fx-font-size: 13px; -fx-padding: 6 16;"/>
                            </VBox>

                            <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                  styleClass="luxury-tile"
                                  onMouseClicked="#onClickApriSezioneOrdini">
                                <Label text="🛵" style="-fx-font-size: 42px;"/>
                                <Label text="Ordini Ricevuti"
                                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                                <Label text="Ordini di oggi, conferme, disdette e storico giornaliero."
                                       wrapText="true" textAlignment="CENTER" style="-fx-font-size: 13px; -fx-text-fill: #baa487; -fx-min-height: 36px;"/>
                                <Button text="Gestisci Ordini ➔" onAction="#onClickApriSezioneOrdini" styleClass="btn-primary" style="-fx-font-size: 13px; -fx-padding: 6 16;"/>
                            </VBox>

                            <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                  styleClass="luxury-tile"
                                  onMouseClicked="#onClickApriSezioneChat">
                                <Label text="💬" style="-fx-font-size: 42px;"/>
                                <Label text="Chat con i Clienti"
                                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                                <Label text="Conversazioni dirette sugli ordini e avvisi di emergenza."
                                       wrapText="true" textAlignment="CENTER" style="-fx-font-size: 13px; -fx-text-fill: #baa487; -fx-min-height: 36px;"/>
                                <Button text="Apri Chat ➔" onAction="#onClickApriSezioneChat" styleClass="btn-primary" style="-fx-font-size: 13px; -fx-padding: 6 16;"/>
                            </VBox>

                            <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="2"
                                  styleClass="luxury-tile"
                                  onMouseClicked="#onClickApriSezioneStatistiche">
                                <Label text="📊" style="-fx-font-size: 42px;"/>
                                <Label text="Statistiche &amp; Analisi"
                                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                                <Label text="Andamento vendite, prodotti più richiesti e stato scorte."
                                       wrapText="true" textAlignment="CENTER" style="-fx-font-size: 13px; -fx-text-fill: #baa487; -fx-min-height: 36px;"/>
                                <Button text="Vedi Statistiche ➔" onAction="#onClickApriSezioneStatistiche" styleClass="btn-primary" style="-fx-font-size: 13px; -fx-padding: 6 16;"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                </ScrollPane>
            </Tab>
            <Tab text="🍨 Menu">
                <VBox spacing="6" styleClass="glass-card" style="-fx-padding: 10 14;">
                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 4 0;">
                        <Button text="⬅ Dashboard" onAction="#onClickTornaDashboard" styleClass="btn-outline" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="🍨 CATALOGO PRODOTTI IN VETRINA"
                               style="-fx-font-family: 'Georgia'; -fx-font-size: 14.5px; -fx-font-weight: bold; -fx-text-fill: #f5ebe0;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="➕ Nuovo Prodotto" onAction="#onClickNuovoGustoMenu" styleClass="btn-sage" minWidth="-Infinity"/>
                    </HBox>
                    <HBox fx:id="boxCategorieMenu" spacing="5" alignment="CENTER_LEFT" style="-fx-padding: 4 2 6 2;"/>

                    <HBox fx:id="boxSottocategorieMenu" spacing="6" alignment="CENTER_LEFT" minHeight="24"/>

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="540" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <FlowPane fx:id="grigliaMenuGestione" hgap="14" vgap="14" style="-fx-padding: 4;"/>
                    </ScrollPane>

                    <HBox spacing="6" alignment="CENTER_LEFT" visible="false" managed="false">
                        <Label fx:id="lblCategoriaFormMenu" text="📂 Reparto: 🍨 Gelati" minWidth="-Infinity"
                               style="-fx-font-weight: bold; -fx-padding: 5 10; -fx-background-color: rgba(35,32,38,0.85); -fx-background-radius: 10; -fx-text-fill: #baa487; -fx-font-size: 12.5px;"/>
                        <ComboBox fx:id="comboCategoriaMenu" visible="false" managed="false"/>
                        <ComboBox fx:id="comboSottocategoriaMenu" visible="false" managed="false"/>
                        <TextField fx:id="campoNomeGustoMenu" promptText="Nome Prodotto" prefWidth="165"/>
                        <TextField fx:id="campoPrezzoGustoMenu" promptText="Prezzo €" prefWidth="85"/>
                        <TextField fx:id="campoAllergeniGustoMenu" promptText="Allergeni" prefWidth="140"/>
                        <TextField fx:id="campoDescGustoMenu" promptText="Descrizione artigianale" HBox.hgrow="ALWAYS"/>
                        <Button text="📁 Scegli foto…" minWidth="-Infinity" onAction="#onClickScegliFoto" styleClass="btn-warm"/>
                        <Label fx:id="lblStatoFotoMenu" text="Nessuna foto" minWidth="-Infinity" style="-fx-font-size: 12.5px; -fx-text-fill: #baa487; -fx-font-style: italic;"/>
                        <Button fx:id="btnRimuoviFoto" text="✕" minWidth="-Infinity" onAction="#onClickRimuoviFoto" styleClass="btn-outline" style="-fx-padding: 2 7; -fx-font-size: 12px;" visible="false" managed="false"/>
                        <TextField fx:id="campoImmagineMenu" visible="false" managed="false"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
                        <Button text="🆕 Nuovo Gusto (svuota)" onAction="#onClickNuovoGustoMenu" styleClass="btn-warm"/>
                        <Button text="➕ Salva / Aggiorna" onAction="#onClickSalvaGustoMenu" styleClass="btn-sage"/>
                        <Button text="🔄 Disponibile / Esaurito" onAction="#onClickCambiaDisponibilitaGusto" styleClass="btn-warm"/>
                        <Button text="🗑️ Rimuovi" onAction="#onClickRimuoviGustoMenu" styleClass="btn-danger"/>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="📅 Turni">
                <VBox spacing="8" styleClass="glass-card" style="-fx-padding: 12 16;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button text="⬅" minWidth="-Infinity" onAction="#onClickTornaDashboard" styleClass="btn-outline"
                                style="-fx-font-size: 12px; -fx-padding: 5 9;"/>
                        <Label text="Turni Staff" minWidth="-Infinity"
                               style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 16.5px; -fx-text-fill: #f5ebe0;"/>
                        <Label fx:id="lblConteggioTurni" minWidth="-Infinity"
                               style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #baa487; -fx-background-color: rgba(35,32,40,0.85); -fx-background-radius: 10; -fx-padding: 4 10;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnToggleStaff" text="👥 Staff" minWidth="-Infinity" onAction="#onTogglePannelloStaff"
                                styleClass="btn-outline" style="-fx-font-size: 11.5px; -fx-padding: 5 11;"/>
                        <MenuButton text="Strumenti" minWidth="-Infinity" styleClass="btn-outline"
                                    style="-fx-font-size: 11.5px; -fx-padding: 1 6;">
                            <items>
                                <MenuItem text="Richieste permessi staff" onAction="#onClickGestisciPermessi"/>
                                <MenuItem text="Fabbisogni di copertura" onAction="#onClickConfiguraFabbisogni"/>
                                <MenuItem text="Ripristina pianificazione precedente" onAction="#onClickRipristinaTurni"/>
                                <SeparatorMenuItem/>
                                <MenuItem text="Gestione anagrafica staff" onAction="#onClickApriSezioneStaff"/>
                            </items>
                        </MenuButton>
                        <Button text="✨ Genera turni" minWidth="-Infinity" onAction="#onClickGeneraTurniAuto"
                                styleClass="btn-primary" style="-fx-font-size: 12px; -fx-padding: 6 14;"/>
                    </HBox>

                    <!-- BARRA COMPATTA NAVIGAZIONE SETTIMANA -->
                    <HBox spacing="6" alignment="CENTER_LEFT" styleClass="luxury-toolbar" style="-fx-padding: 5 10;">
                        <Button text="◀" minWidth="-Infinity" onAction="#onClickSettimanaPrecedente" styleClass="btn-warm" style="-fx-font-size: 11.5px; -fx-padding: 3 9;"/>
                        <Button text="Oggi" minWidth="-Infinity" onAction="#onClickSettimanaCorrente" styleClass="btn-outline" style="-fx-font-size: 11.5px; -fx-padding: 3 10;"/>
                        <Button text="▶" minWidth="-Infinity" onAction="#onClickSettimanaSuccessiva" styleClass="btn-warm" style="-fx-font-size: 11.5px; -fx-padding: 3 9;"/>
                        <Label fx:id="lblSettimanaAttiva" text="Settimana" minWidth="-Infinity"
                               style="-fx-font-weight: bold; -fx-font-size: 12.5px; -fx-text-fill: #f5ebe0; -fx-padding: 0 0 0 8;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Clicca una cella per gestire i turni"
                               style="-fx-font-size: 11px; -fx-text-fill: #a89f92; -fx-font-style: italic;"/>
                        <DatePicker fx:id="datePickerSettimana" onAction="#onCambioDataPicker" prefWidth="118"/>
                    </HBox>

                    <HBox fx:id="boxKpiTurni" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false"/>

                    <!-- CALENDARIO PROTAGONISTA + PANNELLO MONTE ORE RICHIUDIBILE -->
                    <HBox spacing="10" VBox.vgrow="ALWAYS">
                        <VBox fx:id="paneDisponibilitaStaff" spacing="6" prefWidth="210" minWidth="200" maxWidth="220"
                              style="-fx-background-color: rgba(20, 18, 24, 0.90); -fx-border-color: rgba(186,164,135,0.28); -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 8;">
                            <HBox alignment="CENTER_LEFT" spacing="4">
                                <Label text="Monte Ore Staff" minWidth="-Infinity"
                                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 12.5px; -fx-text-fill: #f5ebe0;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="✕" minWidth="-Infinity" onAction="#onTogglePannelloStaff"
                                        style="-fx-background-color: transparent; -fx-text-fill: #a89f92; -fx-font-size: 11px; -fx-padding: 1 5; -fx-cursor: hand;"/>
                            </HBox>
                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                                <VBox fx:id="boxDisponibilitaStaff" spacing="6" style="-fx-padding: 1;"/>
                            </ScrollPane>
                        </VBox>

                        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                            <VBox fx:id="boxCalendarioTurni" spacing="4" style="-fx-padding: 0;"/>
                        </ScrollPane>
                    </HBox>

                    <!-- ELEMENTI COMPATIBILITA' E LISTA RETROCOMPATIBILE -->
                    <ListView fx:id="listaTuttiTurni" visible="false" managed="false"/>
                    <ComboBox fx:id="comboDipendenteTurno" visible="false" managed="false"/>
                    <TextField fx:id="campoEmailDip" visible="false" managed="false"/>
                    <ComboBox fx:id="comboGiornoTurno" visible="false" managed="false"/>
                    <TextField fx:id="campoGiorno" visible="false" managed="false"/>
                    <TextField fx:id="campoOraInizio" visible="false" managed="false"/>
                    <TextField fx:id="campoOraFine" visible="false" managed="false"/>
                </VBox>
            </Tab>
            <Tab text="📦 Magazzino">
                <VBox spacing="12" styleClass="glass-card" style="-fx-padding: 18 20;">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button text="⬅ Torna alla Dashboard" onAction="#onClickTornaDashboard" styleClass="btn-outline"/>
                        <Label text="Giacenze Prodotti Menu &amp; Materie Prime"
                               style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblRiepilogoMagazzino" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                    </HBox>

                    <!-- BARRA FILTRI CATEGORIA & RICERCA (NO SCROLLBAR) -->
                    <HBox spacing="14" alignment="CENTER_LEFT" styleClass="luxury-toolbar">
                        <Label text="📂 Categoria:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                        <ComboBox fx:id="comboCategoriaMagazzino" prefWidth="230"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="campoRicercaMagazzino" promptText="🔍 Cerca prodotto o ingrediente..." prefWidth="280"/>
                    </HBox>

                    <ListView fx:id="listaMagazzino" VBox.vgrow="ALWAYS"/>
                    <Label text="Barra oro/verde = scorta ottimale. Barra rossa = livello sotto soglia minima (da riordinare subito)."
                           style="-fx-font-size: 13px; -fx-text-fill: #baa487;"/>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="luxury-toolbar">
                        <Label text="Gestione Giacenze:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                        <TextField fx:id="campoNomeIngredienteRifornimento" promptText="Seleziona dalla lista sopra" prefWidth="240" editable="false" style="-fx-background-color: rgba(30,28,32,0.85); -fx-font-weight: bold; -fx-text-fill: #f5ebe0; -fx-border-color: rgba(186,164,135,0.3);"/>
                        <TextField fx:id="campoKgRifornimento" promptText="Quantità (es. 10)" prefWidth="130"/>
                        <Button text="📦 Carico (+)" onAction="#onClickRegistraRifornimentoManuale" styleClass="btn-primary" style="-fx-font-weight: bold; -fx-padding: 7 14;"/>
                        <Button text="📤 Scarico (-)" onAction="#onClickRegistraScaricoManuale" styleClass="btn-outline" style="-fx-font-weight: bold; -fx-padding: 7 12;"/>
                        <Button text="🗑 Elimina Voce" onAction="#onClickEliminaIngredienteMagazzino" styleClass="btn-outline" style="-fx-font-weight: bold; -fx-padding: 7 12; -fx-text-fill: #ef4444; -fx-border-color: #ef4444;"/>
                    </HBox>

                    <Separator/>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="luxury-toolbar">
                        <Label text="➕ Nuova Voce:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                        <TextField fx:id="campoNuovoNomeIngrediente" promptText="Nome Prodotto / Materia Prima" prefWidth="220"/>
                        <TextField fx:id="campoNuovaQtaIngrediente" promptText="Q.tà Iniziale (es. 20)" prefWidth="130"/>
                        <TextField fx:id="campoNuovaSogliaIngrediente" promptText="Soglia Min. (es. 5)" prefWidth="120"/>
                        <ComboBox fx:id="comboNuovaUnitaIngrediente" promptText="Unità Misura" prefWidth="130"/>
                        <Button text="✨ Aggiungi al Magazzino" onAction="#onClickAggiungiNuovoIngrediente" styleClass="btn-primary" style="-fx-font-weight: bold; -fx-padding: 7 14;"/>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="⭐ Recensioni">
                <VBox spacing="12" styleClass="glass-card" style="-fx-padding: 18 20;">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button text="⬅ Torna alla Dashboard" onAction="#onClickTornaDashboard" styleClass="btn-outline"/>
                        <VBox spacing="2">
                            <Label text="Recensioni dei Clienti &amp; Risposte Ufficiali del Maestro"
                                   style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #f5ebe0;"/>
                            <Label fx:id="lblRiepilogoRecensioniMaestro" text="Caricamento recensioni..."
                                   style="-fx-font-size: 13px; -fx-text-fill: #baa487;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
