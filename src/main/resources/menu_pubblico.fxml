<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefWidth="1180" prefHeight="760" stylesheets="@style.css" styleClass="root-dark"
           style="-fx-padding: 12;"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="control.grafico.LoginControlGrafico">

    <VBox spacing="6" alignment="CENTER" maxWidth="1150" styleClass="glass-card"
          style="-fx-padding: 14 18;">

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="⬅ Torna all'Accesso" onAction="#onClickTornaALogin" styleClass="btn-outline"/>
            <Label text="FROSTLY — IL NOSTRO MENU D'AUTORE"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #f5ebe0;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox fx:id="boxCategorie" spacing="6" alignment="CENTER"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✨ Crea un Profilo Cliente" onAction="#onClickVaiARegistrazione" styleClass="btn-primary"/>
        </HBox>

        <HBox fx:id="boxSottocategorie" spacing="8" alignment="CENTER" minHeight="26"/>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" prefHeight="620"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <FlowPane fx:id="grigliaProdotti" hgap="14" vgap="14" alignment="TOP_CENTER"
                      style="-fx-padding: 6;"/>
        </ScrollPane>
    </VBox>
</StackPane>
