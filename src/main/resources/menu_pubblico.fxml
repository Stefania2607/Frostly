<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefWidth="1180" prefHeight="760" stylesheets="@style.css" styleClass="root-menu-viola"
           style="-fx-padding: 20;"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="control.grafico.LoginControlGrafico">

    <VBox spacing="6" alignment="CENTER" maxWidth="1120" styleClass="glass-card-viola"
          style="-fx-padding: 14 18;">

        <!-- 1. BARRA SUPERIORE: NAVIGAZIONE, TITOLO E REGISTRAZIONE -->
        <HBox spacing="14" alignment="CENTER_LEFT" style="-fx-padding: 0 0 6 0;">
            <Button text="⬅ Torna all'Accesso" onAction="#onClickTornaALogin" styleClass="btn-outline"
                    minWidth="-Infinity" style="-fx-font-weight: bold; -fx-padding: 7 16;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER" spacing="1">
                <Label text="FROSTLY — IL NOSTRO MENU D'AUTORE"
                       style="-fx-font-family: 'Georgia'; -fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #f5ebe0; -fx-letter-spacing: 1.5px;"/>
                <Label text="Consultazione libera delle nostre eccellenze artigianali"
                       style="-fx-font-size: 12.5px; -fx-text-fill: #baa487;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✨ Crea un Profilo Cliente" onAction="#onClickVaiARegistrazione" styleClass="btn-primary"
                    minWidth="-Infinity" style="-fx-font-weight: bold; -fx-padding: 7 16;"/>
        </HBox>
        <HBox fx:id="boxCategorie" spacing="6" alignment="CENTER" style="-fx-padding: 4 2 6 2;"/>

        <HBox fx:id="boxSottocategorie" spacing="8" alignment="CENTER" minHeight="26"/>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" prefHeight="620"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <FlowPane fx:id="grigliaProdotti" hgap="14" vgap="14" alignment="TOP_CENTER"
                      style="-fx-padding: 6;"/>
        </ScrollPane>
    </VBox>
</StackPane>
